# Cloud browser agent: Chromium + Playwright preinstalled
FROM mcr.microsoft.com/playwright/python:v1.49.0-noble
WORKDIR /app
RUN pip install --no-cache-dir "mcp[cli]>=1.12,<2" httpx "playwright==1.49.0"
COPY browser_mcp.py .
ENV TRANSPORT=http \
    BROWSER_HEADLESS=true \
    BROWSER_PROFILE_DIR=/data/browser-profile \
    UPLOAD_ROOT=/tmp \
    PORT=8000
EXPOSE 8000
CMD ["python", "browser_mcp.py"]

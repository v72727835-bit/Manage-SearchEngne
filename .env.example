# Cloud lead server (server.py)
PORT=8000
MCP_PATH=/mcp-apna-secret-likho-x7k2p      # secret path, jaise password
MY_PROFILE="Python/Django developer, 3 saal ka experience, portfolio: https://..., rate $20-30/hr"
BRAVE_API_KEY=            # optional: web search (free key: https://brave.com/search/api/)
REDDIT_CLIENT_ID=         # optional: Reddit app (https://www.reddit.com/prefs/apps, type "script")
REDDIT_CLIENT_SECRET=
CACHE_TTL_SECONDS=600
SOURCE_TIMEOUT_SECONDS=6   # slow board is skipped after this
HTTP_TIMEOUT_SECONDS=8

# Local browser agent (browser_mcp.py)
CHROME_CDP_URL=http://127.0.0.1:9222   # apna Chrome use karne ke liye (khali chhodo to alag browser khulega)
BROWSER_BLOCK=font,media   # add ,image for even faster pages
BROWSER_SETTLE_MS=1200
UPLOAD_ROOT=C:\Users\YOURNAME\Pictures  # sirf is folder se photo upload ho sakti hai

# GitHub tools (fine-grained token: https://github.com/settings/personal-access-tokens)
GITHUB_TOKEN=
# cPanel tools (token: cPanel -> Security -> Manage API Tokens)
CPANEL_HOST=server.example.com
CPANEL_USER=
CPANEL_API_TOKEN=
# Vercel tools (https://vercel.com/account/tokens)
VERCEL_TOKEN=
